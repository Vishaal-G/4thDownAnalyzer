# Leave unset for local dev -- Vite's dev-server proxy (vite.config.js)
# handles routing /api requests to the local Flask backend.
#
# In production, set this to your deployed backend's full URL (as a build-
# time environment variable in your hosting provider's dashboard, e.g.
# Vercel's Project Settings -> Environment Variables), so the frontend calls
# the real backend instead of a relative path that only works locally.
# VITE_API_URL=https://your-backend.onrender.com
